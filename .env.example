# Ative a confirmação de login por código enviado por e-mail.
EMAIL_2FA_REQUIRED=true

# Gmail: use uma Senha de app de uma Conta Google com verificação em duas etapas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_de_16_caracteres
MAIL_FROM=Central TI <seuemail@gmail.com>

# Obrigatório somente na criação de uma base nova. Defina valores fortes fora do
# Git; após o primeiro início, remova estas três variáveis do ambiente.
# CENTRAL_TI_BOOTSTRAP_ADMIN_NAME=
# CENTRAL_TI_BOOTSTRAP_ADMIN_EMAIL=
# CENTRAL_TI_BOOTSTRAP_ADMIN_PASSWORD=

# Em produção, HTTPS é obrigatório e não pode ser desativado. A Central TI só
# inicia com CENTRAL_TI_TRUST_PROXY=true e HOST local (127.0.0.1, ::1 ou
# localhost). Configure o proxy HTTPS para encaminhar X-Forwarded-Proto: https
# e nunca exponha diretamente a porta do Node.
# NODE_ENV=production
# CENTRAL_TI_TRUST_PROXY=true
# HOST=127.0.0.1

# Opcional: banco de dados corporativo.
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/centralti

# Segurança: as migrações nunca são automáticas. Defina como true apenas em uma
# execução planejada, depois de conferir o backup do banco.
# CENTRAL_TI_RUN_MIGRATIONS=true

# Opcional: onde os backups locais serão guardados. O padrão é ./backups.
# BACKUP_DIR=C:\\CentralTI\\backups

# Opcional, recomendado para dados em arquivo: gere uma chave de 32 bytes em Base64
# com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde a chave fora do Git. Sem ela, uma base criptografada não poderá ser aberta.
# CENTRAL_TI_DATA_ENCRYPTION_KEY=
